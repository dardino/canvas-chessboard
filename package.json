{
  "name": "canvas-chessboard",
  "version": "0.0.19",
  "bugs": {
    "url": "https://github.com/dardino/canvas-chessboard"
  },
  "categories": [
    "Other"
  ],
  "displayName": "Canvas ChessBoard",
  "preview": true,
  "main": "./dist/canvasChessBoard.js",
  "esnext": "./modules/esnext/canvasChessBoard.js",
  "module": "./modules/es2018/canvasChessBoard.js",
  "license": "MIT",
  "description": "Chessboard drawable into HTML5 canvas",
  "typings": "./modules/esnext/",
  "exports": {
    ".": {
      "import": "./modules/esnext/canvasChessBoard.js",
      "require": "./dist/canvasChessBoard.js",
      "types": "./modules/esnext/canvasChessBoard.d.ts"
    },
    "./presets": {
      "import": "./modules/esnext/presets/index.js",
      "require": "./dist/presets.js",
      "types": "./modules/esnext/presets/index.d.ts"
    }
  },
  "keywords": [
    "chess",
    "canvas",
    "board",
    "chessboard",
    "canvas-chessboard"
  ],
  "files": [
    "dist",
    "modules"
  ],
  "author": {
    "name": "Gabriele Brunori",
    "email": "ganori80@gmail.com",
    "url": "https://github.com/dardino"
  },
  "repository": {
    "url": "https://github.com/dardino/canvas-chessboard.git",
    "type": "git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.5.2",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.4",
    "less": "^4.4.2",
    "less-loader": "^12.3.0",
    "style-loader": "^4.0.0",
    "tslib": "^2.8.1",
    "ts-loader": "^9.5.4",
    "typescript": "^6.0.2",
    "webpack": "^5.102.4",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.2"
  },
  "scripts": {
    "build": "webpack --mode production && yarn tsc -b ./src/tsconfig.esnext.json && yarn tsc -b ./src/tsconfig.es2018.json",
    "start:dev": "webpack serve --config webpack.config.js --mode development",
    "deploy:npm": "yarn build && npm publish"
  }
}
